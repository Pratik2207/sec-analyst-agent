# Copy to .env and fill in. Never commit .env.

# SEC requires a descriptive User-Agent with a contact address.
SEC_USER_AGENT="sec-analyst-agent your-email@example.com"

# Postgres container (docker-compose.yml). Owner role, used by ingestion.
POSTGRES_USER=sec_owner
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=sec_analyst
POSTGRES_PORT=5433
DATABASE_URL=postgresql://sec_owner:change-me-owner@localhost:5433/sec_analyst

# Read-only role used by the agent's sql_query tool. `python -m src.db setup`
# creates it with the password given here.
AGENT_DATABASE_URL=postgresql://agent_reader:change-me-reader@localhost:5433/sec_analyst

OLLAMA_HOST=http://localhost:11434
FAST_MODEL=qwen3:1.7b
